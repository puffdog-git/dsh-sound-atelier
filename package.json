{
  "name": "dsh-sound-atelier",
  "version": "1.0.6",
  "description": "DSH-sound-atelier（DSH 聲音工坊）：線上與本機語音合成、人格音色、中文／日文配音、RVC 與中立音訊交付。",
  "license": "MIT",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "lib/",
    "cordis.patch.yml",
    "CHANGELOG.md",
    "README.md",
    "LICENSE",
    "README.en.md",
    "INSTALL.en.md",
    "THIRD-PARTY-NOTICES.md",
    "tools/",
    "LOCAL-RUNTIME.md",
    "PROVIDER-STAGE2.md",
    "CLOUD-VOICES.md",
    "STAGE3-WORKSHOP.md",
    "SPEECH-INTEGRATION.md",
    "PROVIDER-CONTROLS.md",
    "INSTALL.md",
    "SECURITY.md",
    "CONTRIBUTING.md",
    "RELEASE.md",
    "test",
    "COMMUNICATION-COMPATIBILITY.md",
    "LOCAL-CHANGES.md",
    "!**/__pycache__/**",
    "!**/*.pyc",
    "!**/*.log",
    "!**/.env*"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "tts",
    "speech",
    "voice",
    "openai",
    "elevenlabs",
    "deepgram",
    "openrouter"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "build:client": "node tools/build-client.mjs",
    "check:client": "node tools/build-client.mjs --check && node --check lib/client.js",
    "check:release": "node tools/check-release.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-credentials": "^0.1.7-rc.2 || ^0.2.0-rc.1",
    "@deepseek-ai/dsh-host-webserver": "^0.1.7-rc.2 || ^0.2.0-rc.1",
    "@deepseek-ai/dsh-settings": "^0.1.7-rc.2 || ^0.2.0-rc.1",
    "@deepseek-ai/dsh-tools": "^0.1.7-rc.2 || ^0.2.0-rc.1",
    "@deepseek-ai/schemastery": "^3.18.4"
  },
  "dependencies": {
    "@aws-sdk/client-polly": "^3.1167.0",
    "@google-cloud/text-to-speech": "^7.2.0",
    "@msgpack/msgpack": "^3.1.3",
    "@smithy/node-http-handler": "^4.14.2",
    "ffmpeg-static": "^5.3.0",
    "google-auth-library": "^11.3.4",
    "ws": "^8.22.2",
    "yauzl": "3.4.0",
    "yazl": "3.3.1"
  },
  "author": {
    "name": "puffdog-git",
    "url": "https://github.com/puffdog-git"
  },
  "engines": {
    "node": ">=22.15"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/puffdog-git/dsh-sound-atelier.git"
  },
  "homepage": "https://github.com/puffdog-git/dsh-sound-atelier#readme",
  "bugs": {
    "url": "https://github.com/puffdog-git/dsh-sound-atelier/issues"
  }
}
